GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
APP_BASE_URL=http://localhost:8787
PORT=8787

# Optional: enables live multi-source AI Market Intelligence web search
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# FINANCIAL SAFETY: search remains disabled even if API keys are provided
MARKET_ENABLE_LIVE_SEARCH=false
# Optional only with explicit owner approval and provider spending controls
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
MARKET_MAX_SEARCH_QUERIES=3
